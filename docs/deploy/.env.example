# 公开模板：真实域名、访问地址和密码/密钥只写入同目录的 .env，不要提交。
# 标记为自动填写或生成的项目由 deploy.sh init 处理，不需要手工编造。

# [必填，自动填写] 对外主机名，不含协议、路径或端口。
RAKAZO_HOST=
# [必填，自动填写] 后端监听 IP；Nginx 运行在本机时使用 127.0.0.1。
RAKAZO_BIND_ADDRESS=
# [已填默认] 后端 HTTP 端口，不是对外提供 HTTPS 的端口。
RAKAZO_WEB_PORT=5173
# [必填，自动填写] 认证系统的对外地址，用于登录、邮箱验证、SSO 回调等认证相关地址
BETTER_AUTH_URL=
# [必填，自动填写] 用户打开网页的地址，用于浏览器来源校验（CORS、认证可信来源），以及密码重置、集成授权后的页面跳转，与 BETTER_AUTH_URL 保持一致。
WEB_ORIGIN=
# [必填，自动填写] API 对外地址，后端 API 的对外地址，供后台消息集成等功能使用，也参与 API 的来源校验。不是容器内部地址。
API_URL=
# [已填默认] 保持关闭公开注册，使用 deploy.sh owner 创建账号。
SIGNUPS_ENABLED=false
# [可选，可留空] 注册允许名单；由操作员创建账号时保持为空。
SIGNUP_ALLOWLIST=
# [已填默认] 是否启用密码登录；关闭前必须配置 OIDC 身份提供方。
AUTH_PASSWORD_ENABLED=true
# [已填默认] 当前配置不发送邮件，也不支持通过邮件找回密码。
EMAIL_PROVIDER=none
# [已填默认] 使用本机 Docker supervisor 运行智能体计算机。
SANDBOX_PROVIDER=docker
# [已填默认] 阻止智能体计算机访问内网，需要安装宿主机防火墙规则。
SANDBOX_COMPUTER_EGRESS=restricted
# [已填默认] 智能体计算机使用的公共 DNS；restricted 模式会阻止访问内网 DNS。
SANDBOX_COMPUTER_DNS=1.1.1.1,1.0.0.1
# [已填默认] 每台智能体计算机的内存上限，不是整台服务器的限制。
RAKAZO_COMPUTER_MEMORY=2g
# [已填默认] 每台智能体计算机的 CPU 上限。
RAKAZO_COMPUTER_CPUS=2
# [已填默认] 每台智能体计算机的进程数上限。
RAKAZO_COMPUTER_PIDS_LIMIT=2048
# [已填默认] 加密新存储的内容；修改此项不会重写已有数据。
CONTENT_ENCRYPTION=on
# [已填默认] 数据库所有者角色，用于初始化和迁移。
POSTGRES_USER=rakazo
# [已填默认] 数据库名称，首次部署后保持不变。
POSTGRES_DB=rakazo
# [必填，自动生成] 数据库所有者密码；已有数据卷时不要重置。
POSTGRES_PASSWORD=
# [必填，自动生成] 独立的应用数据库受限角色密码。
POSTGRES_APP_PASSWORD=
# [必填，自动生成] 认证密钥，重启和更新时保持不变。
BETTER_AUTH_SECRET=
# [必填，自动生成] 加密密钥；丢失后无法恢复加密数据。
ENCRYPTION_KEY=
# [必填，自动生成] 智能体屏幕代理签名密钥。
SCREEN_PROXY_SECRET=
# [必填，自动生成] 共享令牌，用于授权访问高权限 supervisor。
SANDBOX_SUPERVISOR_TOKEN=
# [已填默认] 官方应用镜像仓库，仅用于 up-images/start-images 模式。
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
# [已填默认] 官方应用镜像标签，不影响源码模式的镜像选择。
RAKAZO_IMAGE_TAG=edge
# [已填默认] 官方计算机镜像仓库，仅用于官方镜像模式。
RAKAZO_COMPUTER_IMAGE=ghcr.io/elie222/rakazo/computer
# [已填默认] 官方计算机镜像标签，应选择与官方应用镜像兼容的版本。
RAKAZO_COMPUTER_IMAGE_TAG=edge
# [可选，可留空] 模型密钥；可以登录后再配置模型连接。
OPENROUTER_API_KEY=
# [已填默认] 源码构建的应用镜像，由 Web、API、Worker、supervisor 和迁移任务共用。
RAKAZO_SOURCE_IMAGE=rakazo-server/app:local
# [已填默认] 源码构建的计算机镜像，用于新启动的智能体计算机。
RAKAZO_SOURCE_COMPUTER_IMAGE=rakazo-server/computer:local
# [已填默认] 应用日志级别，日常运行保持 info。
LOG_LEVEL=info